# Local development defaults. Never use sample DB credentials in production.
# Only the operator CLI reads these demo opt-in variables.
# Run the seed only against a separate, disposable local development database.
PMWIZARD_ENV=development
PMWIZARD_ENABLE_LOCAL_DEMO=false
# Set PMWIZARD_DEMO_PASSWORD securely in your terminal at run time; do not commit it.
# PMWIZARD_AUTH_SECRET must be a separate random >=32-char secret for the API.
# See docs/LOCAL_DEMO_ONBOARDING.md.

PMWIZARD_DATABASE_URL=postgresql+psycopg://pmwizard:pmwizard@localhost:5432/pmwizard

# Optional grounded AI Status Report generation
PMWIZARD_AI_PROVIDER=
PMWIZARD_AI_MODEL=
OPENAI_API_KEY=

# Optional Automation Scheduler worker tuning
PMWIZARD_AUTOMATION_POLL_SECONDS=15
PMWIZARD_AUTOMATION_LEASE_SECONDS=300
PMWIZARD_AUTOMATION_BATCH_SIZE=10
PMWIZARD_AUTOMATION_WORKER_ID=

# Secure Source Runtime examples.
# A Source stores only "env:GRAPH_MAIN"; the worker resolves this variable.
# Use JSON with either bearer_token or entra_client_credentials.
PMWIZARD_SECRET_GRAPH_MAIN=


# Optional Notification Delivery V0
# Public app URL included in outbound notification copy.
PMWIZARD_PUBLIC_BASE_URL=

# SMTP email delivery. Email destination is always the PMWizard account email.
PMWIZARD_NOTIFICATION_SMTP_HOST=
PMWIZARD_NOTIFICATION_SMTP_PORT=587
PMWIZARD_NOTIFICATION_EMAIL_FROM=
PMWIZARD_NOTIFICATION_SMTP_STARTTLS=true
PMWIZARD_NOTIFICATION_SMTP_CREDENTIAL_REF=
# Example:
# PMWIZARD_NOTIFICATION_SMTP_CREDENTIAL_REF=env:SMTP_NOTIFICATIONS
# PMWIZARD_SECRET_SMTP_NOTIFICATIONS={"username":"smtp-user","password":"smtp-password"}

# Teams webhook aliases are stored only as env:TEAMS_* references in preferences.
# Example preference: env:TEAMS_PROJECT_ALERTS
PMWIZARD_SECRET_TEAMS_PROJECT_ALERTS=
