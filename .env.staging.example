# Staging only. COPY to .env.staging and supply strong secrets outside Git.
# Never commit the populated file or deploy using local/demo credentials.
# Database URL must match POSTGRES_* variables; URL-encode special characters.
PMWIZARD_DB_USER=
PMWIZARD_DB_PASSWORD=
PMWIZARD_DB_NAME=
PMWIZARD_STAGING_DATABASE_URL=
PMWIZARD_AUTH_SECRET=
PMWIZARD_PUBLIC_BASE_URL=https://staging.your-domain.example
PMWIZARD_NOTIFICATION_SMTP_HOST=
PMWIZARD_NOTIFICATION_SMTP_PORT=587
PMWIZARD_NOTIFICATION_EMAIL_FROM=
PMWIZARD_NOTIFICATION_SMTP_CREDENTIAL_REF=
PMWIZARD_SECRET_SMTP_NOTIFICATIONS=
