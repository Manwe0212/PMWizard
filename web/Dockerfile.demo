# Next.js DEVELOPMENT server, deliberately used so localhost HTTP cookies work.
# Production hosting requires its own TLS, secret handling and hardened config.
FROM node:22-alpine
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN chown -R node:node /app
USER node
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
