# Development/demo API image. Not a production deployment recipe.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./alembic.ini
RUN pip install --no-cache-dir . \
    && useradd --uid 10001 --create-home pmwizard
USER pmwizard
EXPOSE 8000
CMD ["uvicorn", "pmwizard.api.app:create_default_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
